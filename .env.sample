GEMINI_PROJECT_ID=<GEMINI_PROJECT_ID>
GEMINI_API_KEY=<GEMINI_API_KEY>
GITHUB_TOKEN=<GITHUB_TOKEN>
OPENROUTER_API_KEY = <OPENROUTER_API_KEY>
OPENROUTER_MODEL = <OPENROUTER_MODEL>

# GitHub Copilot CLI instead of an API endpoint (uses the account logged in to the CLI)
# LLM_PROVIDER=COPILOT_CLI
# COPILOT_CLI_MODEL=claude-sonnet-5.5
# COPILOT_CLI_CONTEXT=long_context
# COPILOT_CLI_REASONING_EFFORT=medium
# COPILOT_CLI_TIMEOUT=1200
# COPILOT_CLI_PATH=<path to copilot executable>
